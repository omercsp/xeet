{
    "$defs": {
        "Platform": {
            "enum": [
                "posix",
                "nt"
            ],
            "title": "Platform",
            "type": "string"
        },
        "ResourceModel": {
            "properties": {
                "value": {
                    "title": "Value"
                },
                "name": {
                    "default": "",
                    "title": "Name",
                    "type": "string"
                },
                "pool": {
                    "default": null,
                    "title": "Pool"
                }
            },
            "required": [
                "value"
            ],
            "title": "ResourceModel",
            "type": "object"
        },
        "StepsInheritType": {
            "enum": [
                "prepend",
                "append",
                "replace"
            ],
            "title": "StepsInheritType",
            "type": "string"
        },
        "TestModel": {
            "additionalProperties": false,
            "properties": {
                "name": {
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9_-]*$",
                    "title": "Name",
                    "type": "string"
                },
                "base": {
                    "default": "",
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9_-]*$",
                    "title": "Base",
                    "type": "string"
                },
                "abstract": {
                    "default": false,
                    "title": "Abstract",
                    "type": "boolean"
                },
                "short_desc": {
                    "default": "",
                    "maxLength": 75,
                    "title": "Short Desc",
                    "type": "string"
                },
                "long_desc": {
                    "default": "",
                    "title": "Long Desc",
                    "type": "string"
                },
                "groups": {
                    "items": {
                        "minLength": 1,
                        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
                        "type": "string"
                    },
                    "title": "Groups",
                    "type": "array"
                },
                "pre_run": {
                    "items": {},
                    "title": "Pre Run",
                    "type": "array"
                },
                "run": {
                    "items": {},
                    "title": "Run",
                    "type": "array"
                },
                "post_run": {
                    "items": {},
                    "title": "Post Run",
                    "type": "array"
                },
                "expected_failure": {
                    "default": false,
                    "title": "Expected Failure",
                    "type": "boolean"
                },
                "skip": {
                    "default": false,
                    "title": "Skip",
                    "type": "boolean"
                },
                "skip_reason": {
                    "default": "",
                    "title": "Skip Reason",
                    "type": "string"
                },
                "var_map": {
                    "patternProperties": {
                        "^[a-zA-Z_][a-zA-Z0-9_]*$": {}
                    },
                    "propertyNames": {
                        "minLength": 1
                    },
                    "title": "Var Map",
                    "type": "object"
                },
                "matrix": {
                    "additionalProperties": {
                        "items": {},
                        "type": "array"
                    },
                    "title": "Matrix",
                    "type": "object"
                },
                "platforms": {
                    "items": {
                        "$ref": "#/$defs/Platform"
                    },
                    "title": "Platforms",
                    "type": "array"
                },
                "resources": {
                    "items": {
                        "$ref": "#/$defs/_ResouceRequiremnt"
                    },
                    "title": "Resources",
                    "type": "array"
                },
                "inherit_variables": {
                    "default": true,
                    "title": "Inherit Variables",
                    "type": "boolean"
                },
                "inherit_matrix": {
                    "default": true,
                    "title": "Inherit Matrix",
                    "type": "boolean"
                },
                "pre_run_inheritance": {
                    "$ref": "#/$defs/StepsInheritType",
                    "default": "replace"
                },
                "run_inheritance": {
                    "$ref": "#/$defs/StepsInheritType",
                    "default": "replace"
                },
                "post_run_inheritance": {
                    "$ref": "#/$defs/StepsInheritType",
                    "default": "replace"
                }
            },
            "required": [
                "name"
            ],
            "title": "TestModel",
            "type": "object"
        },
        "_ResouceRequiremnt": {
            "properties": {
                "pool": {
                    "minLength": 1,
                    "pattern": "^*$",
                    "title": "Pool",
                    "type": "string"
                },
                "count": {
                    "default": 1,
                    "minimum": 1,
                    "title": "Count",
                    "type": "integer"
                },
                "names": {
                    "items": {
                        "minLength": 1,
                        "pattern": "^*$",
                        "type": "string"
                    },
                    "title": "Names",
                    "type": "array"
                },
                "as_var": {
                    "default": "",
                    "title": "As Var",
                    "type": "string"
                }
            },
            "required": [
                "pool"
            ],
            "title": "_ResouceRequiremnt",
            "type": "object"
        }
    },
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "title": "$Schema"
        },
        "include": {
            "items": {
                "minLength": 1,
                "type": "string"
            },
            "title": "Include",
            "type": "array"
        },
        "tests": {
            "items": {
                "$ref": "#/$defs/TestModel"
            },
            "title": "Tests",
            "type": "array"
        },
        "variables": {
            "patternProperties": {
                "^[a-zA-Z_][a-zA-Z0-9_]*$": {}
            },
            "propertyNames": {
                "minLength": 1
            },
            "title": "Variables",
            "type": "object"
        },
        "settings": {
            "patternProperties": {
                "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "additionalProperties": true,
                    "type": "object"
                }
            },
            "propertyNames": {
                "minLength": 1
            },
            "title": "Settings",
            "type": "object"
        },
        "resources": {
            "patternProperties": {
                "^*$": {
                    "items": {
                        "$ref": "#/$defs/ResourceModel"
                    },
                    "type": "array"
                }
            },
            "propertyNames": {
                "minLength": 1
            },
            "title": "Resources",
            "type": "object"
        },
        "matrix": {
            "additionalProperties": {
                "items": {},
                "type": "array"
            },
            "title": "Matrix",
            "type": "object"
        }
    },
    "title": "_XeetFullModel",
    "type": "object"
}
